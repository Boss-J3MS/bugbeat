GEMINI_API_KEY=
FRONTEND_URL=http://127.0.0.1:5500
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Set to true only when connecting to a managed host that requires TLS
# (e.g. Aiven). Leave unset/false for local XAMPP.
DB_SSL=false
JWT_SECRET=
JWT_EXPIRES=1d

# Local dev default is fine as-is. Once deployed, set this to wherever the
# Python ML service actually lives (e.g. your Hugging Face Space URL).
ML_SERVICE_URL=http://localhost:5000

# Optional — only needed once the GetSongBPM integration is wired in
GETSONGBPM_API_KEY=
