GEMINI_API_KEY=
FRONTEND_URL=http://127.0.0.1:5500
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Set to true only when connecting to a managed host that requires TLS
# (e.g. Aiven). Leave unset/false for local XAMPP.
DB_SSL=false
JWT_SECRET=
JWT_EXPIRES=1d

# Local dev default is fine as-is. Once deployed, set this to the ML
# service's Cloud Run URL, and ML_API_KEY to the same key set on Cloud Run.
ML_SERVICE_URL=http://localhost:5000
ML_API_KEY=

# Claude API: the advanced analysis for Student Pro (and admins), and the
# fallback for Free when Gemini fails. Leave empty to use Gemini only.
ANTHROPIC_API_KEY=
# Optional; defaults to claude-haiku-5-5.
ANTHROPIC_MODEL=

# Student Pro payments through PayMongo (test mode keys start with sk_test_
# and pk_test_). Without PAYMONGO_SECRET_KEY, buying is switched off but the
# Free / Pro limits still work. Run migrations/billing.sql first.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# The secret key of the webhook created in PayMongo for /webhooks/paymongo.
PAYMONGO_WEBHOOK_SECRET=
# Optional: 'off' hides auto-renew; payment methods offered at checkout.
PAYMONGO_AUTO_RENEW=
PAYMONGO_METHODS=
